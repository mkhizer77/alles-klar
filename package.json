{
  "name": "alles-klar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A German course from A1 to B1: grammar concepts in easy English, spaced-repetition vocabulary, interactive exercises and level tests. Web app that installs on mobile.",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node --watch server/node.ts\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/node.ts",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && cp dist/index.html dist/404.html",
    "start": "NODE_ENV=production node server/node.ts",
    "preview": "vite preview",
    "validate": "node scripts/validate-content.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "deploy:api": "wrangler deploy",
    "test": "node --test server/core/*.test.ts tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "marked": "^15.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "wrangler": "^4.153.0"
  }
}
